{
  "compilerOptions": {
    "target": "ES2023",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      // thinking-orbs is published as a React component and its .d.ts imports
      // from 'react'. Mapping React onto preact/compat lets it typecheck and
      // bundle against the Preact already here, rather than pulling a second
      // renderer into the app.
      "react": ["node_modules/preact/compat"],
      "react-dom": ["node_modules/preact/compat"],
      "react/jsx-runtime": ["node_modules/preact/jsx-runtime"]
    }
  },
  "include": ["src"],
  "exclude": ["src/workers/ml.worker.ts"]
}
