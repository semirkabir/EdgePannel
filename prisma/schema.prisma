// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String? // Hashed password for email/password auth
  image         String?
  preferences   Json      @default("{\"rotationSpeed\": 0.05, \"autoRotate\": true, \"pauseOnHover\": false, \"viewMode\": \"globe\"}")
  accounts      Account[]
  sessions      Session[]
  apiKeys       ApiKey[]
  trades        Trade[]
  watchlists    Watchlist[]
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ApiKey {
  id                String   @id @default(cuid())
  userId            String
  platform          String   // "polymarket" or "kalshi"
  // For Polymarket: encrypted API key
  // For Kalshi: encrypted access key ID and private key
  encryptedKey      String   @db.Text
  encryptedKeyData  String?  @db.Text // Additional encrypted data (e.g., Kalshi private key)
  isActive          Boolean  @default(true)
  
  // Rotation fields
  expiresAt         DateTime? // When this key expires (null = no expiration)
  rotationDate      DateTime? // When key was last rotated
  previousKeyHash   String? // Hash of previous key for transition period
  rotationReminderSent Boolean @default(false) // Whether reminder email was sent
  nextRotationDate  DateTime? // When key should be rotated next
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, platform])
  @@index([expiresAt])
  @@index([nextRotationDate])
}

model MarketCache {
  id            String   @id @default(cuid())
  platform      String   // "polymarket" or "kalshi"
  marketId      String
  data          Json     // Cached market data
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  
  @@unique([platform, marketId])
  @@index([expiresAt])
}

model Trade {
  id            String   @id @default(cuid())
  userId        String
  platform      String   // "polymarket" or "kalshi"
  marketId      String
  marketTitle   String
  side          String   // "buy" or "sell"
  quantity      Float
  price         Float
  totalAmount   Float
  status        String   // "pending", "filled", "cancelled", "failed"
  orderId       String?  // External order ID from platform
  executedAt    DateTime?
  createdAt     DateTime @default(now())
  
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([platform, marketId])
}

model Watchlist {
  id            String   @id @default(cuid())
  userId        String
  platform      String   // "polymarket" or "kalshi"
  marketId      String
  marketTitle   String
  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, marketId])
  @@index([userId])
}

model GeotaggedMarket {
  id            String   @id @default(cuid())
  marketId      String   @unique // platform-externalId
  platform      String   // "polymarket" or "kalshi"
  externalId    String   // The market's ID on the platform
  title         String   @db.Text
  description   String   @db.Text
  category      String?  // Primary category/tag
  tags          String[] @default([]) // All tags for the market
  probability   Float?
  volume24h     Float?
  liquidity     Float?
  endDate       DateTime?
  slug          String?
  ticker        String?

  // Geolocation data
  country       String?
  region        String?
  city          String?
  latitude      Float?
  longitude     Float?
  confidence    String?  // "high", "medium", "low"
  extractedFrom String?  // "country", "city", "state", "pattern"

  // Metadata
  rawData       Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([platform])
  @@index([country])
  @@index([latitude, longitude])
  @@index([confidence])
  @@index([endDate])
  @@index([category])
}

model MarketSyncState {
  id          String   @id @default(cuid())
  platform    String   @unique // "polymarket" or "kalshi"
  lastSeenId  String   // Last market ID processed
  lastSyncAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketPriceHistory {
  id          String   @id @default(cuid())
  marketId    String   // External market ID from platform
  platform    String   // "polymarket" or "kalshi"
  price       Float    // Current probability/price
  volume24h   Float    @default(0)
  liquidity   Float?
  metadata    Json     @default("{}")
  timestamp   DateTime @default(now())

  @@index([marketId, timestamp(sort: Desc)])
  @@index([platform, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?  // User who performed the action (null for system actions)
  action      String   // Action type: "LOGIN", "LOGOUT", "API_KEY_CREATED", "API_KEY_UPDATED", "API_KEY_DELETED", "API_KEY_ROTATED", "TRADE_EXECUTED", "PASSWORD_CHANGED", "EMAIL_CHANGED", etc.
  resource    String   // Resource type: "user", "api_key", "trade", "settings", etc.
  resourceId  String?  // ID of the affected resource
  details     Json?    // Additional context (IP, user agent, changes made, etc.)
  ipAddress   String?  // IP address of the request
  userAgent   String?  // User agent string
  status      String   @default("SUCCESS") // "SUCCESS", "FAILURE", "ERROR"
  errorMessage String? // Error message if status is FAILURE or ERROR
  timestamp   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId, timestamp(sort: Desc)])
  @@index([action, timestamp(sort: Desc)])
  @@index([resource, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@index([status, timestamp(sort: Desc)])
}
