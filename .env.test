# Test Environment Variables
# Used during test execution

NODE_ENV=test

# Test Encryption Key (32 characters)
ENCRYPTION_KEY=test-encryption-key-32-chars!!

# Test NextAuth Secret
NEXTAUTH_SECRET=test-nextauth-secret-for-testing-only

# Test Database (optional - tests use mocks)
DATABASE_URL=postgresql://test:test@localhost:5432/test

# Disable Redis for unit tests
REDIS_URL=

# Disable rate limiting in tests
RATE_LIMIT_ENABLED=false

# Test secrets provider (always local for tests)
SECRETS_PROVIDER=local
