{
  "name": "prediction-markets-map-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:setup": "docker-compose up -d && npx prisma db push && npx prisma generate",
    "dev:reset": "docker-compose down -v && docker-compose up -d && npx prisma db push",
    "build": "prisma generate && next build",
    "start": "concurrently \"next start\" \"npm run cron:start\"",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "generate-secrets": "node scripts/generate-secrets.js",
    "cron:start": "npx tsx scripts/local-cron-scheduler.ts",
    "cron:test": "npx tsx scripts/test-cron.ts",
    "db:studio": "npx prisma studio"
  },
  "dependencies": {
